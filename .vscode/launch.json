{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: trace POST /api/care-plans/",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "0.0.0.0:8000", "--noreload"],
      "django": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "CAREPLAN_DEBUG_BREAKPOINTS": "1",
        "DJANGO_SETTINGS_MODULE": "careplan_mvp.settings",
        "POSTGRES_HOST": "localhost",
        "POSTGRES_PORT": "5432",
        "POSTGRES_DB": "careplan",
        "POSTGRES_USER": "careplan",
        "POSTGRES_PASSWORD": "careplan",
        "REDIS_URL": "redis://localhost:6379/0"
      },
      "console": "integratedTerminal"
    }
  ]
}
