DJANGO_SECRET_KEY=dev-only-secret-key

POSTGRES_DB=careplan
POSTGRES_USER=careplan
POSTGRES_PASSWORD=careplan
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
CAREPLAN_QUEUE_NAME=careplan_queue
CAREPLAN_EXECUTION_BACKEND=celery
CAREPLAN_K8S_NAMESPACE=default
CAREPLAN_K8S_IMAGE=
CAREPLAN_K8S_BACKOFF_LIMIT=3
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

GCP_PROJECT=
GCP_LOCATION=us-central1

# Used by Docker Compose to point Vertex AI / Gemini at host ADC:
# Windows: %APPDATA%\gcloud\application_default_credentials.json
# (mounted into the container as GOOGLE_APPLICATION_CREDENTIALS)
